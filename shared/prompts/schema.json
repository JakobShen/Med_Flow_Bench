{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medflow-bench.org/schemas/prompt.schema.json",
  "title": "MedFlowBench Prompt Definition",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "prompt_id",
    "version",
    "benchmark",
    "track",
    "description",
    "entrypoints",
    "templates"
  ],
  "$defs": {
    "templateNode": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/templateNode"
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "benchmark": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/templateNode"
      }
    }
  },
  "additionalProperties": true
}
