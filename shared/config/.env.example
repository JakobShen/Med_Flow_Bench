# 3D Slicer runtime (required for Track A and Track B)
SLICER_EXECUTABLE=/path/to/Slicer
SLICER_BASE_URL=http://127.0.0.1:2016
SLICER_WEBSERVER_PORT=2016
SLICER_WEBSERVER_ENABLE_SLICER=1
SLICER_WEBSERVER_ENABLE_EXEC=1

# Provider selection
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_REASONING_EFFORT=

# Local OpenAI-compatible vLLM server
LOCAL_VLLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_VLLM_API_KEY=EMPTY
LOCAL_VLLM_MODEL=

# Optional prompt override; defaults to shared/prompts in a source checkout
MEDFLOW_PROMPT_DIR=

# Direct provider APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# Google Vertex AI (use application-default credentials or an API key)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_API_KEY=

# Claude on Vertex AI
ANTHROPIC_USE_VERTEXAI=false
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=global

# Optional MONAI Label / VISTA3D service
MONAI_LABEL_SERVER_URL=http://127.0.0.1:8001
MONAI_LABEL_MODEL=vista3d

# Optional local Track C workers
M3D_PYTHON=/path/to/m3d/environment/bin/python
M3D_MODEL_PATH=GoodBaiBai88/M3D-LaMed-Phi-3-4B
RADFM_PYTHON=/path/to/radfm/environment/bin/python
RADFM_REPO_ROOT=/path/to/RadFM
RADFM_CHECKPOINT=/path/to/pytorch_model.bin

# QuPath runtime (BRACS and CAMELYON17)
QUPATH_EXECUTABLE=/path/to/QuPath
QUPATH_DEFAULT_IMAGE=
QUPATH_PROCESS_NAME=
QUPATH_DISPLAY_ID=
QUPATH_DISPLAY_DPR=

# QuPath host-agent settings
WORKSTATION_AGENT_PROVIDER=openai
WORKSTATION_AGENT_MODEL=
WORKSTATION_AGENT_OPENAI_MODEL=gpt-5.4-mini
WORKSTATION_AGENT_GEMINI_MODEL=gemini-2.5-pro
WORKSTATION_AGENT_REASONING_EFFORT=
WORKSTATION_AGENT_MAX_TOKENS=1600
WORKSTATION_AGENT_TEMPERATURE=0
WORKSTATION_AGENT_GEMINI_BACKEND=
WORKSTATION_AGENT_VERTEX_PROJECT=
WORKSTATION_AGENT_VERTEX_LOCATION=
OPENAI_BASE_URL=

# Optional Midscene QuPath GUI sidecar
MIDSCENE_QUPATH_SIDECAR_DIR=/path/to/repository/qupath/runtime/qupath_sidecar
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=
