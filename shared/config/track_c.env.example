# Copy this file to .env.track_c, then replace every /path/to value.
#
# Track C is runtime-independent: it does not require 3D Slicer, WebServer,
# Xvfb, or any Slicer extension.

# Python 3.10.x environment created by create_vllm_env.sh.
PYTHON_BIN=/path/to/medflow-bench/.venv-vllm/bin/python

# Dataset inputs shared with the Track A/B runners.
UCSF_DATA_ROOT=/path/to/data/ucsf-pdgm
UCSF_METADATA_CSV=/path/to/data/ucsf-pdgm/UCSF-PDGM-metadata_v5.csv
NSCLC_DATA_ROOT=/path/to/data/nsclc-radiogenomics
NSCLC_METADATA_CSV=/path/to/data/nsclc-radiogenomics/metadata.csv
NSCLC_LABELS_CSV=/path/to/data/nsclc-radiogenomics/NSCLCR01Radiogenomic_DATA_LABELS_2018-05-22_1500-shifted.csv
LUMIERE_DATA_ROOT=/path/to/data/LUMIERE
LUMIERE_RATINGS_CSV=/path/to/data/LUMIERE/LUMIERE-ExpertRating-v202211.csv
LUMIERE_COMPLETENESS_CSV=/path/to/data/LUMIERE/LUMIERE-datacompleteness.csv

# The paper's 2D slice-montage baseline is called compressed_figures in code.
TRACK_C_METHOD=compressed_figures
TRACK_C_MODEL_KEYS=medgemma-1.5-4b-it
TRACK_C_RESULTS_ROOT=/path/to/results/track_c
TRACK_C_RESUME=1

# Hosted providers are optional. Fill only the credentials for selected models.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local open-weight serving. Run create_vllm_env.sh first.
VLLM_BIN=/path/to/medflow-bench/.venv-vllm/bin/vllm
VLLM_PORT=8000
VLLM_API_KEY=EMPTY
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_IMAGE_LIMIT=16
VLLM_START_TIMEOUT_SEC=900
LOCAL_VLLM_MAX_TOOL_CALLS_PER_TURN=1
LOCAL_VLLM_MAX_INPUT_IMAGES=16
LOCAL_VLLM_MAX_HISTORY_TOOL_ROUNDS=3
LOCAL_VLLM_MAX_TOOL_RESULT_CHARS=8000
LOCAL_VLLM_MAX_OUTPUT_TOKENS=2048
VLLM_NO_USAGE_STATS=1
MEDFLOW_VLLM_CACHE_DIR=

# Optional local weight directories. Otherwise vLLM downloads from Hugging Face.
VLLM_MODEL_PATH_QWEN3_5_35B_A3B=
VLLM_MODEL_PATH_QWEN3_5_27B=
VLLM_MODEL_PATH_QWEN3_5_9B=
VLLM_MODEL_PATH_QWEN3_5_4B=
VLLM_MODEL_PATH_GEMMA_3_27B_IT=
VLLM_MODEL_PATH_MEDGEMMA_1_5_4B_IT=
VLLM_MODEL_PATH_MEDGEMMA_27B_IT=
VLLM_MODEL_PATH_LINGSHU_32B=
HF_TOKEN=

# Default reproducibility check: five units from each dataset. Use 0 for the
# full 139/495/162 eligible-unit protocol.
TRACK_C_LIMIT=5
# Optional per-dataset overrides. Blank values inherit TRACK_C_LIMIT.
TRACK_C_LUMIERE_LIMIT=
TRACK_C_UCSF_LIMIT=
TRACK_C_NSCLC_LIMIT=
