# Copy this file to .env.table1, then replace every /path/to value.

# Python 3.10.x environment created by create_vllm_env.sh.
PYTHON_BIN=/path/to/medflow-bench/.venv-vllm/bin/python

# 3D Slicer Track A runtime.
SLICER_EXECUTABLE=/path/to/Slicer
SLICER_BASE_URL=http://127.0.0.1:2016
# Optional on headless Linux or non-system application installations.
XVFB_BIN=
XVFB_LIB_DIR=
TABLE1_DISPLAY=:99
SLICER_EXTRA_LIBRARY_PATH=
# The user-space dependency helper also prints these when they are needed.
LIBGL_DRIVERS_PATH=

# Table 1 dataset inputs.
UCSF_DATA_ROOT=/path/to/data/ucsf-pdgm
UCSF_METADATA_CSV=/path/to/data/ucsf-pdgm/UCSF-PDGM-metadata_v5.csv
NSCLC_DATA_ROOT=/path/to/data/nsclc-radiogenomics
NSCLC_METADATA_CSV=/path/to/data/nsclc-radiogenomics/metadata.csv
NSCLC_LABELS_CSV=/path/to/data/nsclc-radiogenomics/NSCLCR01Radiogenomic_DATA_LABELS_2018-05-22_1500-shifted.csv
LUMIERE_DATA_ROOT=/path/to/data/LUMIERE
LUMIERE_RATINGS_CSV=/path/to/data/LUMIERE/LUMIERE-ExpertRating-v202211.csv
LUMIERE_COMPLETENESS_CSV=/path/to/data/LUMIERE/LUMIERE-datacompleteness.csv

# "all" reproduces every Table 1 row. Use "medgemma", "open", or "hosted"
# for a focused model block.
TABLE1_MODEL_SET=all
TABLE1_RESULTS_ROOT=/path/to/results/table1
TABLE1_RESUME=1

# Hosted providers. Fill only the providers selected by TABLE1_MODEL_SET/KEYS.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional hosted endpoint overrides if a preview name has changed.
TABLE1_MODEL_ID_GPT_5_4_MINI=
TABLE1_MODEL_ID_GPT_5_5=
TABLE1_MODEL_ID_GEMINI_3_FLASH_PREVIEW=
TABLE1_MODEL_ID_GEMINI_3_1_PRO_PREVIEW=
TABLE1_MODEL_ID_CLAUDE_SONNET_4_6=
TABLE1_MODEL_ID_CLAUDE_OPUS_4_7=

# Optional Vertex AI configuration for Gemini or Claude.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
ANTHROPIC_USE_VERTEXAI=false
ANTHROPIC_VERTEX_PROJECT_ID=
ANTHROPIC_VERTEX_REGION=global

# Local open-weight serving. Run create_vllm_env.sh first.
VLLM_BIN=/path/to/medflow-bench/.venv-vllm/bin/vllm
VLLM_PORT=8000
VLLM_API_KEY=EMPTY
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_IMAGE_LIMIT=16
VLLM_START_TIMEOUT_SEC=900
# Execute one viewer action, inspect its result, then choose the next action.
LOCAL_VLLM_MAX_TOOL_CALLS_PER_TURN=1
LOCAL_VLLM_MAX_INPUT_IMAGES=16
# Keep the original task plus the latest Slicer interactions. The live Slicer
# scene persists when old prompt messages are removed.
LOCAL_VLLM_MAX_HISTORY_TOOL_ROUNDS=3
LOCAL_VLLM_MAX_TOOL_RESULT_CHARS=8000
# Caps each agent response; prevents open-weight models from generating until
# the full context window when their chat template omits a reliable stop token.
LOCAL_VLLM_MAX_OUTPUT_TOKENS=2048
VLLM_NO_USAGE_STATS=1
# Recommended on clusters with small home-directory quotas.
MEDFLOW_VLLM_CACHE_DIR=

# Optional local weight directories. Otherwise vLLM downloads from Hugging Face.
# The variable suffix is the model key uppercased with punctuation replaced by "_".
VLLM_MODEL_PATH_QWEN3_5_35B_A3B=
VLLM_MODEL_PATH_QWEN3_5_27B=
VLLM_MODEL_PATH_QWEN3_5_9B=
VLLM_MODEL_PATH_QWEN3_5_4B=
VLLM_MODEL_PATH_GEMMA_3_27B_IT=
VLLM_MODEL_PATH_MEDGEMMA_1_5_4B_IT=
VLLM_MODEL_PATH_MEDGEMMA_27B_IT=
VLLM_MODEL_PATH_LINGSHU_32B=

# Required for gated Gemma/MedGemma repositories after accepting their terms.
HF_TOKEN=

# The default one-command run uses five units per dataset. Set TABLE1_LIMIT=0
# (or pass --limit 0) for the paper's full 139/495/162 eligible-case protocol.
TABLE1_LIMIT=5
# Optional per-dataset overrides. Blank values inherit TABLE1_LIMIT.
TABLE1_LUMIERE_LIMIT=
TABLE1_UCSF_LIMIT=
TABLE1_NSCLC_LIMIT=
